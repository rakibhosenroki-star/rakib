# MD RAKIB HASAN - BACKEND ENVIRONMENT CONFIGURATION
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rakib_hasan_portfolio

# JWT Secret for Secure Admin Authentication
JWT_SECRET=rakib_hasan_super_secure_jwt_secret_key_2026_!@#$
JWT_EXPIRES_IN=7d

# Default Admin Credentials (Auto-seeded if users table is empty)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=rakib2026

# Allowed Frontend Origins (CORS)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
